generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Application {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  endpoints Endpoint[]

  @@map("applications")
}

model Endpoint {
  id             String   @id @default(uuid())
  applicationId  String   @map("application_id")
  name           String
  url            String
  httpMethod     String   @default("GET") @map("http_method")
  cronExpression String   @map("cron_expression")
  expectedStatus Int      @default(200) @map("expected_status")
  timeoutMs      Int      @default(5000) @map("timeout_ms")
  headers        Json?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  application Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  logs        MonitoringLog[]

  @@map("endpoints")
}

model MonitoringLog {
  id             String   @id @default(uuid())
  endpointId     String   @map("endpoint_id")
  statusCode     Int      @map("status_code")
  responseTimeMs Int      @map("response_time_ms")
  isSuccess      Boolean  @map("is_success")
  errorMessage   String?  @map("error_message")
  checkedAt      DateTime @default(now()) @map("checked_at")

  endpoint Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@map("monitoring_logs")
}